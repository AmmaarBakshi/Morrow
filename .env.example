# Morrow configuration. Copy to .env (or run `npm run morrow -- init`, which
# also generates a secret key) and adjust. Never commit real values.

# ------------------------------------------------------------------ runtime
# development | production | test
MORROW_ENV=development
PORT=4400
HOST=0.0.0.0
# Which processes this instance runs (server,worker,scheduler). Split them across machines if you like.
MORROW_ROLES=server,worker,scheduler

# Public base URL. Appears in unsubscribe, tracking and verification links,
# so it must be reachable by recipients and https:// in production.
MORROW_PUBLIC_URL=http://localhost:4400
# Where people open the web app (defaults to MORROW_PUBLIC_URL).
# MORROW_APP_URL=

# Master secret: encrypts provider credentials at rest and signs links.
# At least 32 random characters in production. Rotating it invalidates stored secrets and old links.
MORROW_SECRET_KEY=replace-me-with-a-long-random-value

# ------------------------------------------------------------------ database
# SQLite (single machine):   sqlite:./data/morrow.db
# PostgreSQL (recommended):  postgres://morrow:password@localhost:5432/morrow
DATABASE_URL=sqlite:./data/morrow.db

# ------------------------------------------------------------------ e-mail
# fake (development inbox: nothing is delivered) | smtp | resend | postmark
# Workspaces can also configure their own provider in Settings → Sending.
MORROW_EMAIL_PROVIDER=fake
# Allow the development provider outside development (never in real production).
# MORROW_ALLOW_DEV_PROVIDER=false

# From address for invitations, sender verification and alerts.
# MORROW_SYSTEM_FROM_EMAIL=no-reply@example.com
# MORROW_SYSTEM_FROM_NAME=Morrow

# SMTP
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USERNAME=
# SMTP_PASSWORD=

# Resend
# RESEND_API_KEY=
# RESEND_WEBHOOK_SECRET=

# Postmark
# POSTMARK_SERVER_TOKEN=
# POSTMARK_TRANSACTIONAL_STREAM=outbound
# POSTMARK_BROADCAST_STREAM=broadcast
# POSTMARK_WEBHOOK_USERNAME=
# POSTMARK_WEBHOOK_PASSWORD=

# ------------------------------------------------------------------ AI (optional)
# Drafting help only; Morrow never sends AI output without a person. Leave unset to disable.
# MORROW_AI_PROVIDER=anthropic
# MORROW_AI_MODEL=claude-opus-5-5
# ANTHROPIC_API_KEY=

# ------------------------------------------------------------------ security & operations
# Allow anyone to sign up after the first account (defaults to false in production).
# MORROW_ALLOW_SIGNUP=false
# MORROW_SESSION_TTL_DAYS=14
# Honour X-Forwarded-For from a reverse proxy you control.
# MORROW_TRUST_PROXY=false
# Bearer token required to scrape /metrics (otherwise /metrics is disabled in production).
# MORROW_METRICS_TOKEN=

# ------------------------------------------------------------------ tuning
# MORROW_WORKER_CONCURRENCY=4
# MORROW_WORKER_POLL_MS=1000
# MORROW_JOB_LEASE_MS=120000
# MORROW_SCHEDULER_INTERVAL_MS=30000
# MORROW_JOB_RETENTION_DAYS=30
