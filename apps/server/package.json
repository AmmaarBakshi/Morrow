{
  "name": "@morrow/server",
  "version": "0.1.0",
  "private": true,
  "description": "Morrow HTTP API, public tracking/unsubscribe endpoints, webhooks and single-node runtime.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "start": "tsx src/main.ts",
    "build": "tsup"
  },
  "dependencies": {
    "@hono/node-server": "~1.19.17",
    "@morrow/core": "*",
    "@morrow/db": "*",
    "@morrow/email": "*",
    "@morrow/engine": "*",
    "hono": "^4.10.8",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "tsup": "~8.5.1"
  }
}
